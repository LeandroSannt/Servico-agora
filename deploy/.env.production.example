# Copie para /opt/servico-agora/.env e preencha.
# Gere senhas com: openssl rand -base64 32

NODE_ENV=production

# Banco (Postgres roda no Docker, sem porta exposta)
POSTGRES_USER=admin
POSTGRES_PASSWORD=TROQUE
POSTGRES_DB=servico_agora

# Endereco publico. Sem dominio use o IP; com dominio use https://app.seudominio.com.br
# e defina SITE_ADDRESS=app.seudominio.com.br (o Caddy emite o certificado).
SITE_ADDRESS=:80
AUTH_URL=http://191.252.222.159
NEXTAUTH_URL=http://191.252.222.159

# NextAuth
AUTH_SECRET=TROQUE
NEXTAUTH_SECRET=TROQUE

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp: EVOLUTION ou META
WHATSAPP_PROVIDER=META
META_GRAPH_API_VERSION=v21.0
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_APP_ID=
META_MOCK=false
