# Copie para /opt/servico-agora/.env e preencha.
# Gere senhas com: openssl rand -base64 32

NODE_ENV=production

# Banco (Postgres roda no Docker, sem porta exposta)
POSTGRES_USER=admin
POSTGRES_PASSWORD=TROQUE
POSTGRES_DB=servico_agora

# Dominio publico (o Caddy emite o certificado HTTPS sozinho; o IP continua acessivel por HTTP)
SITE_DOMAIN=servicoagora.com.br
AUTH_URL=https://servicoagora.com.br
NEXTAUTH_URL=https://servicoagora.com.br

# NextAuth
AUTH_SECRET=TROQUE
NEXTAUTH_SECRET=TROQUE

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp: EVOLUTION ou META
WHATSAPP_PROVIDER=META
META_GRAPH_API_VERSION=v21.0
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_APP_ID=
META_MOCK=false
